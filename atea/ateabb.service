
[Unit]
Description=Compose-managed Docker application
Requires=docker.service
After=docker.service network.target

[Service]
Type=exec
WorkingDirectory=/opt/ateabb-live/hosting/scripts/bb-airgapped
ExecStart=/usr/bin/docker compose up --build --remove-orphans
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=10
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
